# Copiez vers .env pour le dev local, ou renseignez les mêmes clés dans Dokploy.

# PostgreSQL (adapter l’hôte : localhost en local, nom interne Dokploy en prod)
DATABASE_URL=postgresql://sondage:sondage_dev@localhost:5432/sondage?schema=public

# Cookie « session affichage » : true uniquement derrière HTTPS
COOKIE_SECURE=false

# --- Démarrage conteneur (scripts/docker-entrypoint.sh) ---
# Pause (secondes) avant la première tentative de migrate (Dokploy : défaut 8 si non défini)
# MIGRATE_BOOT_SLEEP=8
# Nombre max de tentatives prisma migrate deploy
# MIGRATE_MAX_ATTEMPTS=10
# Secondes entre deux échecs
# MIGRATE_RETRY_PAUSE=3

# Docker Compose uniquement : port publié sur l’hôte pour le service web
# WEB_HOST_PORT=3000
